{
  "manifest_version": 3,
  "name": "FormMemory",
  "version": "1.2.0",
  "description": "Smart local form autofill & job application assistant with zero external servers.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FormMemory - Job & Form Autofill",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "formmemory@antigravity.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open FormMemory extension popup"
    },
    "quick_fill_job": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Autofill Job Application on current page"
    }
  }
}
